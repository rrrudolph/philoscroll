// Open /?k=<password>. This function cannot attach a cookie to the file
// CloudFront fetches, so a correct password answers with a redirect that
// sets one. The browser then requests the page, and that page's script and
// fonts go out with the cookie and without the query string. A wrong
// password in the link is refused even when an older cookie is still stored.

function handler(event) {
  var password = ${password_json};
  var queryName = ${query_name_json};
  var cookieName = ${cookie_name_json};
  var request = event.request;
  var provided = queryValue(request, queryName);

  if (provided) {
    if (provided !== password) return denied();
    return remember(event, request, cookieName, password);
  }

  if (cookieValue(request, cookieName) !== password) return denied();
  var canonical = viewerPath(request.uri);
  if (canonical !== safePath(request.uri)) {
    return {
      statusCode: 301,
      statusDescription: "Moved Permanently",
      headers: {
        location: { value: "https://" + hostName(event, request) + canonical },
        "cache-control": { value: "no-store" }
      }
    };
  }
  request.uri = originUri(request.uri);
  return request;
}

function queryValue(request, name) {
  var query = request.querystring && request.querystring[name];
  if (!query || !query.value) return "";
  return query.value;
}

function cookieValue(request, name) {
  var cookie = request.cookies && request.cookies[name];
  if (!cookie || !cookie.value) return "";
  return cookie.value;
}

function safePath(uri) {
  if (!uri || uri.charAt(0) !== "/" || uri.indexOf("//") !== -1 || uri.indexOf("\\") !== -1) {
    return "/";
  }
  return uri;
}

function originUri(uri) {
  var path = safePath(uri);
  if (path === "/") return path;
  if (path.charAt(path.length - 1) === "/") return path + "index.html";
  var last = path.lastIndexOf("/");
  var leaf = path.slice(last + 1);
  if (leaf.indexOf(".") === -1) return path + "/index.html";
  return path;
}

function viewerPath(uri) {
  var path = safePath(uri);
  if (path === "/") return path;
  var last = path.lastIndexOf("/");
  var leaf = path.slice(last + 1);
  if (leaf.indexOf(".") === -1 && path.charAt(path.length - 1) !== "/") {
    return path + "/";
  }
  return path;
}

function hostName(event, request) {
  var host = request.headers && request.headers.host && request.headers.host.value;
  if (host) return host;
  return event.context.distributionDomainName;
}

function remember(event, request, cookieName, password) {
  // CloudFront rejects a generated response that puts Set-Cookie in headers.
  var cookies = {};
  cookies[cookieName] = {
    value: password,
    attributes: "Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=31536000"
  };
  return {
    statusCode: 302,
    statusDescription: "Found",
    headers: {
      location: { value: "https://" + hostName(event, request) + viewerPath(request.uri) },
      "cache-control": { value: "no-store" }
    },
    cookies: cookies
  };
}

function denied() {
  return {
    statusCode: 401,
    statusDescription: "Unauthorized",
    headers: {
      "content-type": { value: "text/html; charset=utf-8" },
      "cache-control": { value: "no-store" },
      "x-robots-tag": { value: "noindex" }
    },
    body: "<!doctype html>"
      + "<html lang=\"en\">"
      + "<head>"
      + "<meta charset=\"utf-8\">"
      + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
      + "<meta name=\"robots\" content=\"noindex\">"
      + "<title>PhiloScroll</title>"
      + "<style>"
      + "html{background:#ede4d3;color:#000000}"
      + "@media (prefers-color-scheme: dark){html{background:#0d1014;color:#e5e7eb}}"
      + "body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:Georgia,serif}"
      + "p{font-size:1.4rem;line-height:1.5;padding:1.5rem;text-align:center}"
      + "</style>"
      + "</head>"
      + "<body><p>This scroll is private.</p></body>"
      + "</html>"
  };
}
